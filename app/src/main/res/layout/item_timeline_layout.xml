<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="2dp"
    android:background="@drawable/bg_entry_card">

    <!-- Text entry -->
    <TextView
        android:id="@+id/textTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:textSize="14sp"
        android:textColor="@color/md_theme_dark_onSurface" />

    <TextView
        android:id="@+id/readMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Read more"
        android:textColor="@color/md_theme_dark_primaryContainers"
        android:textSize="13sp"
        android:visibility="gone"
        android:paddingTop="2dp"
        android:layout_marginStart="8dp" />

    <!-- Task container -->
    <LinearLayout
        android:id="@+id/taskContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/taskCheckbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Task status" />

        <TextView
            android:id="@+id/taskText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:textColor="@color/md_theme_dark_onSurface" />

    </LinearLayout>

    <!-- Image entry -->
    <ImageView
        android:id="@+id/imageEntry"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:contentDescription="Entry image"
        android:visibility="gone" />

    <!-- Audio container -->
    <LinearLayout
        android:id="@+id/audioContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
    <!-- Date/Time and Logbook Name row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/md_theme_dark_onSurface2" />

        <TextView
            android:id="@+id/logbookName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="@color/md_theme_logbook_name" />
    </LinearLayout>
    <!-- Note -->
    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:textSize="12sp"
        android:textColor="@color/md_theme_dark_tertiary"
        android:visibility="gone" />
    <TextView
        android:id="@+id/noteReadMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Read more"
        android:textColor="@color/md_theme_dark_primaryContainers"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginStart="8dp"
        android:paddingTop="2dp" />

    <!-- Separator -->

</LinearLayout>
