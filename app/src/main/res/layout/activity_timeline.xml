<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/timeline_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_onPrimary"
    tools:context=".TimelineActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_dark_surface"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="Timeline"
                android:textColor="@color/md_theme_dark_onSurface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/moreMenuButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@color/md_theme_dark_surface"
                android:src="@drawable/ic_moremenu"
                android:contentDescription="More options"
                android:padding="8dp"
                app:tint="@color/md_theme_dark_primary" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timelineRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="4dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:listitem="@layout/item_timeline_layout" />

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/md_theme_dark_surface"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Logbooks -->
        <LinearLayout
            android:id="@+id/navLogbooks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_logbooks"
                android:contentDescription="Logbooks"
                android:scaleType="centerInside"
                app:tint="@color/md_theme_dark_primary" />

            <TextView
                android:id="@+id/navLogbooksLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logbooks"
                android:textSize="10sp"
                android:textColor="@color/md_theme_dark_primary" />
        </LinearLayout>

        <!-- Timeline -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/md_theme_dark_primaryContainer"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/navTimeline"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_timeline"
                android:contentDescription="Timeline"
                android:scaleType="centerInside"
                app:tint="@color/md_theme_dark_onSurface" />

            <TextView
                android:id="@+id/navTimelineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timeline"
                android:textSize="10sp"
                android:textColor="@color/md_theme_dark_onSurface" />
        </LinearLayout>

        <!-- All Tasks -->
        <LinearLayout
            android:id="@+id/navAllTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_alltasks"
                android:contentDescription="All Tasks"
                android:scaleType="centerInside"
                app:tint="@color/md_theme_dark_primary" />

            <TextView
                android:id="@+id/navAllTasksLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Tasks"
                android:textSize="10sp"
                android:textColor="@color/md_theme_dark_primary" />
        </LinearLayout>

        <!-- Bookmarks -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/navBookmarked"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_bookmarked"
                android:contentDescription="Bookmarks"
                android:scaleType="centerInside"
                app:tint="@color/md_theme_dark_primary" />

            <TextView
                android:id="@+id/navBookmarkedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookmarks"
                android:textSize="10sp"
                android:textColor="@color/md_theme_dark_primary" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
